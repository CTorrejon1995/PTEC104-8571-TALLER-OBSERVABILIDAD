{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "infraestructura",
      "folder": "Observabilidad",
      "interval": "10s",
      "rules": [
        {
          "uid": "cpu-high",
          "title": "CPU alta · laboratorio",
          "condition": "C",
          "for": "1m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "CPU del entorno Linux de Docker por encima del 80 % durante 1 minuto",
            "description": "Promedio no ocioso de 5 minutos. CPU observada: {{ $values.B.Value }} %. En la prueba controlada el umbral se cambia temporalmente a -1 %.",
            "__dashboardUid__": "operativo-observabilidad",
            "__panelId__": "1"
          },
          "labels": {
            "severity": "warning",
            "component": "infraestructura",
            "scope": "docker-linux"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "threshold",
                "expression": "B",
                "refId": "C",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        80
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
